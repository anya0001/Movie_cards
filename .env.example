SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Leave DATABASE_URL unset to use the built-in SQLite database (recommended
# for local use). Only set this if you're pointing at a real Postgres server,
# e.g. for production: postgresql://user:password@host:5432/dbname
# DATABASE_URL=
